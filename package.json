{
  "name": "icecheck",
  "version": "0.1.0",
  "description": "A TanStack Start SPA for two-device WebRTC connectivity diagnostics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/icecheck.git"
  },
  "bugs": {
    "url": "https://github.com/michidk/icecheck/issues"
  },
  "homepage": "https://icecheck.vercel.app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "start": "node .output/server/index.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "nitro": "^3.0.260610-beta",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
