{
  "name": "icecheck",
  "version": "0.1.0",
  "description": "A TanStack Start SPA for two-device WebRTC connectivity diagnostics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/icecheck.git"
  },
  "bugs": {
    "url": "https://github.com/michidk/icecheck/issues"
  },
  "homepage": "https://icecheck.vercel.app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . && node scripts/check-architecture.mjs",
    "start": "node .output/server/index.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc --noEmit",
    "verify": "npm run lint && npm test",
    "verify:full": "npm run verify && npm run test:e2e"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "nitro": "^3.0.260610-beta",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
